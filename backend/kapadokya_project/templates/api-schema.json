{
  "openapi": "3.0.0",
  "info": {
    "title": "Kapadokya ÜVS API",
    "version": "1.0.0",
    "description": "Kapadokya Üretim Verimlilik Sistemi (ÜVS) API Dokümantasyonu",
    "contact": {
      "name": "Kapadokya AI Teknik Destek",
      "email": "support@kapadokya.ai"
    }
  },
  "servers": [
    {
      "url": "/api",
      "description": "Ana API Sunucusu"
    }
  ],
  "paths": {
    "/auth/login/": {
      "post": {
        "summary": "Kullanıcı Girişi",
        "description": "Kullanıcı adı ve şifre ile kimlik doğrulama yaparak bir token alır",
        "tags": ["Kimlik Doğrulama"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "admin"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "şifreniz"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Başarılı giriş",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "example": "1a2b3c4d5e6f7g8h9i0j"
                    },
                    "id": {
                      "type": "integer",
                      "example": 1
                    },
                    "username": {
                      "type": "string",
                      "example": "admin"
                    },
                    "name": {
                      "type": "string",
                      "example": "Admin Kullanıcı"
                    },
                    "email": {
                      "type": "string",
                      "example": "admin@kapadokya.com"
                    },
                    "role": {
                      "type": "string",
                      "example": "Yönetici"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Kimlik doğrulama başarısız oldu"
          }
        }
      }
    },
    "/isg/alerts/": {
      "get": {
        "summary": "İSG Uyarıları",
        "description": "İş Sağlığı ve Güvenliği uyarılarını listeler",
        "tags": ["İSG Modülü"],
        "parameters": [
          {
            "name": "X-API-KEY",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API anahtarı"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["Açık", "Çözüldü", "İnceleniyor"]
            },
            "description": "Uyarı durumuna göre filtreleme"
          },
          {
            "name": "from_date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Başlangıç tarihi filtreleme"
          },
          {
            "name": "to_date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Bitiş tarihi filtreleme"
          }
        ],
        "responses": {
          "200": {
            "description": "Başarılı işlem",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "example": 1
                      },
                      "alert_type": {
                        "type": "string",
                        "example": "Baret İhlali"
                      },
                      "camera_name": {
                        "type": "string",
                        "example": "Kamera-1 (Üretim Alanı)"
                      },
                      "timestamp": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-04-26T12:30:45Z"
                      },
                      "status": {
                        "type": "string",
                        "example": "Açık"
                      },
                      "priority": {
                        "type": "string",
                        "example": "Yüksek"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Yetkisiz erişim"
          }
        }
      },
      "post": {
        "summary": "Yeni İSG Uyarısı Oluştur",
        "description": "Yeni bir İSG uyarısı oluşturur",
        "tags": ["İSG Modülü"],
        "parameters": [
          {
            "name": "X-API-KEY",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API anahtarı"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["alert_type", "camera_name"],
                "properties": {
                  "alert_type": {
                    "type": "string",
                    "example": "Baret İhlali"
                  },
                  "camera_name": {
                    "type": "string",
                    "example": "Kamera-1 (Üretim Alanı)"
                  },
                  "priority": {
                    "type": "string",
                    "enum": ["Düşük", "Orta", "Yüksek"],
                    "example": "Yüksek"
                  },
                  "details": {
                    "type": "string",
                    "example": "Çalışan baret kullanmadan tehlikeli alana girdi"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Uyarı başarıyla oluşturuldu"
          },
          "400": {
            "description": "Geçersiz istek veya veri"
          },
          "403": {
            "description": "Yetkisiz erişim"
          }
        }
      }
    },
    "/verim/tasks/": {
      "get": {
        "summary": "Verimlilik Görevleri",
        "description": "Verimlilik takip görevlerini listeler",
        "tags": ["Verimlilik Modülü"],
        "parameters": [
          {
            "name": "X-API-KEY",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API anahtarı"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["Bekleyen", "Devam Ediyor", "Tamamlandı"]
            },
            "description": "Görev durumuna göre filtreleme"
          }
        ],
        "responses": {
          "200": {
            "description": "Başarılı işlem",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "example": 1
                      },
                      "title": {
                        "type": "string",
                        "example": "Montaj Hattı Kontrolü"
                      },
                      "assigned_to": {
                        "type": "string",
                        "example": "Ahmet Yılmaz"
                      },
                      "status": {
                        "type": "string",
                        "example": "Devam Ediyor"
                      },
                      "start_date": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-04-25T09:00:00Z"
                      },
                      "end_date": {
                        "type": "string",
                        "format": "date-time",
                        "example": null
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Yetkisiz erişim"
          }
        }
      }
    },
    "/rapor/reports/": {
      "get": {
        "summary": "Raporlar",
        "description": "Sistem raporlarını listeler",
        "tags": ["Raporlama Modülü"],
        "parameters": [
          {
            "name": "X-API-KEY",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API anahtarı"
          },
          {
            "name": "report_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["İSG", "Verimlilik", "Üretim"]
            },
            "description": "Rapor türüne göre filtreleme"
          }
        ],
        "responses": {
          "200": {
            "description": "Başarılı işlem",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "example": 1
                      },
                      "title": {
                        "type": "string",
                        "example": "Haftalık İSG Raporu"
                      },
                      "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-04-20T15:30:00Z"
                      },
                      "report_type": {
                        "type": "string",
                        "example": "İSG"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Yetkisiz erişim"
          }
        }
      },
      "post": {
        "summary": "Yeni Rapor Oluştur",
        "description": "Yeni bir sistem raporu oluşturur",
        "tags": ["Raporlama Modülü"],
        "parameters": [
          {
            "name": "X-API-KEY",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API anahtarı"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "report_type"],
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Aylık Verimlilik Raporu"
                  },
                  "report_type": {
                    "type": "string",
                    "enum": ["İSG", "Verimlilik", "Üretim"],
                    "example": "Verimlilik"
                  },
                  "time_period": {
                    "type": "string",
                    "enum": ["Günlük", "Haftalık", "Aylık", "Yıllık"],
                    "example": "Aylık"
                  },
                  "parameters": {
                    "type": "object",
                    "example": {
                      "include_charts": true,
                      "include_recommendations": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Rapor başarıyla oluşturuldu"
          },
          "400": {
            "description": "Geçersiz istek veya veri"
          },
          "403": {
            "description": "Yetkisiz erişim"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY"
      },
      "TokenAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
